[sub_resource type="StyleBoxEmpty" id="Style_hit"]

[sub_resource type="Shader" id="Shader_aura"]
code = "shader_type canvas_item;
uniform float header_clearance = 0.0;
void fragment() {
    vec4 art = COLOR;
    float rune = 1.0 - smoothstep(0.09, 0.18, abs(UV.y - 0.37));
    art.a *= mix(0.24, 0.95, rune);
    art.a *= mix(1.0, smoothstep(0.26, 0.36, UV.y), header_clearance);
    COLOR = art;
}"

[sub_resource type="ShaderMaterial" id="Material_aura"]
shader = SubResource("Shader_aura")

[sub_resource type="ShaderMaterial" id="Material_aura_center"]
