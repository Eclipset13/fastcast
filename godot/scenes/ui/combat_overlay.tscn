[sub_resource type="Shader" id="Shader_damage_vignette"]
code = "shader_type canvas_item;\nuniform float strength : hint_range(0.0, 1.0) = 0.0;\nvoid fragment() {\n\tvec2 p = (UV - vec2(0.5)) * vec2(1.0, 0.78);\n\tfloat d = length(p);\n\tfloat edge = smoothstep(0.27, 0.61, d);\n\tfloat corners = smoothstep(0.36, 0.64, d);\n\tfloat alpha = max(edge * 0.78, corners) * strength;\n\tCOLOR = vec4(0.92, 0.015, 0.055, alpha);\n}\n"

